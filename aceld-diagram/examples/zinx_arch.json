    { "id": "utils",   "x": 540, "y": 1090, "w": 140, "h": 50, "fill": "slate", "label": "Utils 工具" }
  ],
  "groups": [
    { "nodes": ["server","conn","connmgr","heartbeat"], "title": "接入与网络层 · Network", "stroke": "#6FA8CF", "fill": "#EAF3FA" },
    { "nodes": ["decoder","datapack","message"], "title": "编解码层 · Codec", "stroke": "#6DBE8B", "fill": "#EAF6EE" },
    { "nodes": ["msghandler","workerpool","request"], "title": "分发与处理层 · Dispatch", "stroke": "#9AA0A6", "fill": "#F0F1F3" },
    { "nodes": ["router"], "title": "业务路由层 · Business", "stroke": "#D98B84", "fill": "#FDECEA" },
