{
  "meta": {
    "title": "Zinx 轻量级 TCP 服务器框架",
    "subtitle": "Golang 并发服务器框架 · 请求处理链路架构（Connection → Decode → Dispatch → Router）"
  },
  "monitor": { "label": "接口层", "fill": "slate" },
  "nodes": [
