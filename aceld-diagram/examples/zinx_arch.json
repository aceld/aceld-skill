    { "id": "router", "x": 400, "y": 850, "w": 220, "h": 64, "fill": "crimson", "label": "Router 业务路由" },

    { "id": "config",  "x": 300, "y": 1010, "w": 140, "h": 50, "fill": "slate", "label": "Config 配置" },
    { "id": "logger",  "x": 460, "y": 1010, "w": 140, "h": 50, "fill": "slate", "label": "Logger 日志" },
    { "id": "timer",   "x": 620, "y": 1010, "w": 140, "h": 50, "fill": "slate", "label": "Timer 定时器" },
